# Backend environment. Copy to .env for a bare `npm run dev`;
# docker-compose supplies the same values to the service directly.

NODE_ENV=development
PORT=3001

MONGODB_URI=mongodb://admin:password@localhost:27017/ecommerce?authSource=admin

# Signs admin session tokens. Generate a fresh one with:
#   openssl rand -base64 48
ADMIN_JWT_SECRET=dev-only-insecure-secret-change-me

# How long an admin session lasts before it must be signed in again.
ADMIN_TOKEN_TTL=8h

# Comma-separated list of origins allowed to call the admin API.
ADMIN_ORIGIN=http://localhost:5173
